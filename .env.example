# Copy this file to .env and fill in real values. .env is gitignored —
# never commit real secrets.

ANTHROPIC_API_KEY=sk-ant-your-key-here

# Phase 2: used by pipeline.aggregate to embed dish names for fuzzy
# matching. Free tier available at https://dash.voyageai.com
VOYAGE_API_KEY=pa-your-key-here

# Matches the credentials in docker-compose.yml — no need to change this
# for local development.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dishfinder
